# Copier en .env puis adapter. INSTANCE_NAME = nom de l'index (un projet = une instance).
INSTANCE_NAME=mrae-beaumont
# Isole cette instance des autres deployees depuis le meme dossier
# (conteneurs, reseau ET volumes -- voir docker-compose.yml). Sans cette
# variable, Docker Compose derive le nom de projet du nom du DOSSIER,
# identique pour toutes les instances installees ici.
COMPOSE_PROJECT_NAME=luciole-mrae-beaumont
TZ=Europe/Paris

API_PORT=8000
WATCHER_PORT=8090
QDRANT_PORT=6333
OPENSEARCH_PORT=9200
OLLAMA_PORT=11434
OLLAMA_CONTEXT_LENGTH=32768

WATCHER_ENABLED=true
WATCHER_MAX_FILE_SIZE_MB=9999
