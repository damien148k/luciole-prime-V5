# Configuration d'une instance Luciole V4 — UNIQUE source de verite.
# Chaque cle est lue sur cet objet a chaque usage ; aucun composant n'en
# garde de copie. Modifier ici puis « reload config » depuis l'UI suffit.
# Les variables d'environnement Docker (QDRANT_URL, OPENSEARCH_URL,
# LLM_URL, INSTANCE_NAME) l'emportent sur les cles correspondantes.

instance:
  name: mrae-beaumont          # = collection Qdrant, index OpenSearch (minuscules)

embedding:
  model: BAAI/bge-m3
  device: auto
  batch_size: 32

reranker:
  model: BAAI/bge-reranker-v2-m3
  device: auto
  batch_size: 32

retrieval:
  bm25_top_k: 40               # pool brut BM25
  dense_top_k: 40              # pool brut dense
  search_top_k: 100            # sortie de la fusion RRF
  fusion_top_k: 40             # pool soumis au reranker
  rerank_top_n: 10             # passages conserves pour le LLM (seule definition)
  bm25_weight: 0.45
  dense_weight: 0.55
  rrf_k: 60

llm:
  provider: ollama
  model: qwen2.5:14b-instruct-q4_K_M
  base_url: http://ollama:11434
  api_format: ollama           # porte native /api/chat : num_ctx transmis
  temperature: 0
  seed: 42
  max_tokens: 4096
  num_ctx: 32768               # A5000 (24 Go) : fenetre pleine 32768
  timeout: 1800
  # Options Ollama envoyees a chaque appel (query2 v3.1). repeat_penalty 1.05
  # limite les boucles du decodage glouton (temperature 0) sans changer le
  # ton ; a comparer avec 1.0 sur la campagne de reference avant de le garder.
  options:
    repeat_penalty: 1.05
    repeat_last_n: 256

chunking:
  # 1024/150 : valeurs retenues apres les campagnes Brissy et Beaumont Sud
  # du 7 septembre 2026. Un chunk plus large porte le contexte d'un
  # paragraphe entier de tome d'etude d'impact ; le recouvrement evite de
  # couper une mesure au milieu.
  chunk_size: 1024
  chunk_overlap: 150
  strategy: sentence
  include_file_context: true
  adaptive: true

chunking_strategies:
  pdf:  {strategy: sentence,  chunk_size: 1024, chunk_overlap: 150}
  docx: {strategy: paragraph, chunk_size: 600, chunk_overlap: 80}
  xlsx: {strategy: row_group, rows_per_chunk: 20, include_header: true}
  pptx: {strategy: slide,     chunk_size: 800, chunk_overlap: 0}
  msg:  {strategy: email,     chunk_size: 800, chunk_overlap: 0}
  txt:  {strategy: sentence,  chunk_size: 400, chunk_overlap: 50}

pdf:
  enable_ocr: false
  markdown_timeout: 0
  markdown_timeout_per_page: 2.0
  ocr_dpi: 300
  max_drawings_per_page: 500
  min_yield_ratio: 0.5

qdrant:
  host: localhost
  port: 6333
  collection_name: mrae-beaumont

opensearch:
  host: localhost
  port: 9200
  index_name: mrae-beaumont

# Fichiers tabulaires (.xlsx, .xls). Le parser avance ecrit les donnees
# brutes dans une base SQLite pour permettre des recherches structurees.
# Cette base va dans backups\ et JAMAIS dans data\ : le watcher monte le
# dossier de documents en lecture seule, SQLite ne peut pas y ecrire.
excel:
  sqlite_path: /app/backups/excel_data.db
  enable_sql_storage: true
  max_rows_per_chunk: 50

# Le watcher est la seule voie d'ingestion : deposer, modifier ou
# supprimer un fichier dans watched_paths declenche l'indexation.
watcher:
  enabled: true
  watched_paths:
    - path: /app/data
      recursive: true
      index_name: mrae-beaumont
  polling_interval: 5.0
  debounce_seconds: 3.0
  stability_checks: 3
  stability_interval: 2.0
  max_worker_threads: 1
  reconcile_interval: 300
  reconcile_on_startup: true
  max_file_size_mb: 9999
  db_path: /app/backups/watcher/watcher.db
  api_port: 8090
  default_index_name: mrae-beaumont

# Pipeline de reponse (src/rag/query2.py, v3.6) :
#   1. analyse de la demande (prompts.yaml : analyse_*), puis composition des
#      questions par gabarits (gabarits_questions) : l'objet d'abord, puis un
#      motif par question ; repli sur questions_prompt si l'analyse echoue ;
#   2. chaque question : recherche hybride + rerank + generation avec les
#      reglages `retrieval` ci-dessus, la demande transmise en cadrage
#      (cadrage_prompt) ; gardes par bloc : esquive -> profil `deep`,
#      tronque / degenere -> relance sous `relance`, pages citees hors lot
#      -> signalees ;
#   3. synthese LLM (demande + analyse + blocs cites) avec les memes gardes,
#      concatenation des blocs en repli et en annexe ; verdict COUVERT /
#      PARTIEL / NON_COUVERT dans la trace.
query2:
  # --- lot (retriever.py v3.6, après le rerank) ---
  documents_secondaires: ["RNT", "resume_non_technique", "résumé non technique"]  # motifs de nom de fichier
  plafond_secondaires: 2        # passages au plus issus de ces documents par lot (0 : désactivé)
  exclure_sommaires: true       # écarte les passages de sommaire / liste de cartes
  # --- synthèse (query2.py v3.6) ---
  retention_min: 0.6            # part des données des blocs à retrouver dans la synthèse
  retention_relance: true       # sous le seuil : une relance avec les lignes omises
  retention_annexe: true        # toujours sous le seuil : lignes jointes telles quelles
  transformation: true     # etape 1 active (false = la demande est posee telle quelle)
  max_questions: 6         # objet (1 ou 2) + aspects + motifs ; au-dela, les derniers sont tronques (warning)
  cadrage: true            # transmettre la demande a la generation (cadrage_prompt)
  repli_esquive: true      # reponse esquivee -> seconde passe avec le profil deep
  deep:                    # profil elargi : repli automatique, et toggle UI
    bm25_top_k: 80
    dense_top_k: 80
    search_top_k: 200
    fusion_top_k: 60
    rerank_top_n: 20
  objet:                   # budget de la seule question « objet » (elle couvre un chapitre entier)
    rerank_top_n: 15
  relance_boucle: true     # relancer un bloc tronque (max_tokens) ou degenere (lignes en boucle)
  relance:                 # options LLM de la relance (surcharge temporaire)
    repeat_penalty: 1.1
    repeat_last_n: 256
  signaler_hors_lot: true  # note en fin de bloc listant les pages citees absentes du lot
  synthese: true           # etape 3 : redaction LLM a partir des blocs (synthese_prompt) ; repli = concatenation
  annexe_blocs: true       # joindre les blocs par question sous la synthese ("Detail par question")
  degenere:                # seuils de detection d'une reponse qui boucle
    min_lignes: 8
    ratio_min: 0.6
    repetitions_max: 4

# Evaluation RAGAS (onglet RAGAS de l'interface admin). Absente = le
# modele de generation ci-dessus sert aussi de juge.
ragas:
  eval_model: qwen2.5:14b-instruct-q4_K_M   # juge des metriques
  embed_model: nomic-embed-text             # a telecharger dans Ollama

logging:
  level: INFO